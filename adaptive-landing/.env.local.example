# ────────────────────────────────────────────────────────
# 솔라피 SMS API
# https://console.solapi.com 에서 발급
# ────────────────────────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# 발신번호 (솔라피 콘솔에 사전 등록 필수)
SOLAPI_SENDER=

# 기본 관리자 수신번호 (현장 파일에 adminPhones 없을 때 폴백)
ADMIN_PHONE=
# ADMIN_PHONE2=

# ────────────────────────────────────────────────────────
# Google Sheets API (서비스 계정)
# Google Cloud Console → IAM → 서비스 계정 → 키 발급
# ────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 개행 문자는 \n 으로 이스케이프해서 한 줄로 입력
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 기본 스프레드시트 ID (URL의 /d/ 뒤 문자열)
# 현장 파일에 sheetId 있으면 해당 값 우선 사용
GOOGLE_SHEET_ID=

# 기본 시트 탭 이름 (현장 파일에 sheetTab 없을 때 폴백)
# GOOGLE_SHEET_DEFAULT_TAB=상담신청

# ────────────────────────────────────────────────────────
# 카카오 알림톡 (솔라피 콘솔 → 카카오 알림톡 → 채널 관리)
# 현장 파일에 kakao: true 설정 시 SMS 대신 알림톡 우선 발송 (실패 시 SMS로 자동 폴백)
# ────────────────────────────────────────────────────────
KAKAO_SENDER_KEY=
KAKAO_TEMPLATE_ID=
